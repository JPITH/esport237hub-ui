{
  "name": "@esport237hub/ui",
  "version": "0.1.0",
  "description": "Design system ESPORT 237 HUB basé sur Astryx (Meta) — tokens, thème light/dark, composants web (React) et natifs (React Native).",
  "license": "MIT",
  "author": "ESPORT 237 HUB",
  "repository": {
    "type": "git",
    "url": "https://github.com/JPITH/esport237hub-ui.git"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./tokens": "./src/tokens/index.ts",
    "./theme": "./src/theme/esport237.ts",
    "./theme.css": "./src/theme/theme.css",
    "./css": "./src/css/global.css",
    "./lib": "./src/lib/index.ts",
    "./web": "./src/web/index.tsx",
    "./web/astryx": "./src/web/astryx.ts",
    "./web/fields": "./src/web/fields.tsx",
    "./native": "./src/native/index.tsx"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.web.json && tsc -p tsconfig.native.json",
    "lint": "tsc -p tsconfig.web.json --noEmit"
  },
  "dependencies": {
    "@astryxdesign/core": "0.1.7",
    "@astryxdesign/theme-neutral": "0.1.7",
    "@stylexjs/stylex": "^0.19.0"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0",
    "react-native": "*",
    "react-native-svg": "*",
    "react-native-reanimated": "*",
    "lucide-react": "*",
    "lucide-react-native": "*",
    "@esport237hub/types": "*"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    },
    "react-native": {
      "optional": true
    },
    "react-native-svg": {
      "optional": true
    },
    "react-native-reanimated": {
      "optional": true
    },
    "lucide-react-native": {
      "optional": true
    },
    "@esport237hub/types": {
      "optional": true
    }
  },
  "devDependencies": {
    "@esport237hub/types": "workspace:*",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "lucide-react": "^0.562.0",
    "lucide-react-native": "^0.562.0",
    "react": "^19.2.0",
    "react-native": "^0.85.0",
    "react-native-reanimated": "^4.0.0",
    "react-native-svg": "^15.0.0",
    "typescript": "^5.9.2"
  }
}
